// ============================================================
// Chatgram - Prisma Schema
// Full-featured messenger database schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  // Phone is the unique username (normalized: digits only, no +98, leading 0)
  phone         String   @unique
  passwordHash  String
  avatarUrl     String?
  bio           String?
  role          UserRole @default(USER)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  sentMessages       Message[]         @relation("MessageSender")
  receivedMessages   MessageReceipt[]
  conversations      ConversationParticipant[]
  uploads            Attachment[]
  auditLogs          AdminAuditLog[]    @relation("AuditActor")
  auditedAsTarget    AdminAuditLog[]    @relation("AuditTarget")
  adminSettings      AdminSetting[]

  @@index([phone])
  @@index([role])
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  token         String   @unique
  expiresAt     DateTime
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// Conversations
// ============================================================

model Conversation {
  id            String   @id @default(cuid())
  type          ConversationType @default(DIRECT)
  title         String?  // For group chats
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationParticipant {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  joinedAt        DateTime @default(now())
  lastReadAt      DateTime @default(now())
  // For hidden/typing flag per user
  isMuted         Boolean  @default(false)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// ============================================================
// Messages
// ============================================================

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  body            String?
  type            MessageType @default(TEXT)
  replyToId       String?
  forwardedFromId String?
  isDeleted       Boolean  @default(false)
  deletedForEveryone Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  forwardedFrom   Message?     @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  attachments     Attachment[]
  receipts        MessageReceipt[]
  replies         Message[]    @relation("MessageReply")
  forwardedBy    Message[]    @relation("MessageForward")

  @@index([conversationId, createdAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
}

model MessageReceipt {
  id           String          @id @default(cuid())
  messageId    String
  userId       String
  status       ReceiptStatus
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  message      Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

enum ReceiptStatus {
  DELIVERED
  READ
}

// ============================================================
// Attachments
// ============================================================

model Attachment {
  id              String   @id @default(cuid())
  messageId       String?
  uploaderId      String
  fileName        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  // Chunked upload state
  storagePath     String
  uploadStatus    UploadStatus @default(COMPLETED)
  totalChunks     Int      @default(1)
  receivedChunks  Int      @default(0)
  // Thumbnails / previews
  thumbnailPath   String?
  width           Int?
  height          Int?
  durationSec     Int?
  createdAt       DateTime @default(now())

  message         Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader        User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
}

enum UploadStatus {
  UPLOADING
  COMPLETED
  ABORTED
}

// ============================================================
// Admin Audit Log
// ============================================================

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorId       String
  targetUserId  String?
  action        AuditAction
  targetType    AuditTargetType?
  targetId      String?
  metadata      String?  // JSON string
  ipAddress     String?
  createdAt     DateTime @default(now())

  actor         User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  target        User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

enum AuditAction {
  VIEW_CONVERSATION
  VIEW_MESSAGE
  VIEW_ATTACHMENT
  VIEW_USER_LIST
  UPDATE_ADMIN_PHONE
  UPDATE_USER_ROLE
  DELETE_USER
  DOWNLOAD_ATTACHMENT
}

enum AuditTargetType {
  USER
  CONVERSATION
  MESSAGE
  ATTACHMENT
}

// ============================================================
// Admin Settings (configurable, not hardcoded)
// ============================================================

model AdminSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  updatedById   String?
  updatedAt     DateTime @updatedAt

  updatedBy     User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// ============================================================
// User Presence (online/offline tracking for WS service)
// ============================================================

model UserPresence {
  id            String   @id @default(cuid())
  userId        String   @unique
  isOnline      Boolean  @default(false)
  lastSeenAt    DateTime @default(now())
  socketId      String?

  @@index([isOnline])
}
