# ============================================================
# Chatgram - Environment Variables Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Database (SQLite file path)
# IMPORTANT: Use a path relative to the prisma/ folder.
# "file:./dev.db" creates db/dev.db next to schema.prisma.
# On Windows, use forward slashes (/) — Prisma normalizes them.
DATABASE_URL="file:./dev.db"

# Session / JWT (use a long random string >=32 chars in production)
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_STRING_32_CHARS_OR_MORE"
SESSION_COOKIE_NAME="messenger_session"

# Initial Admin (used only by seed script, NOT hardcoded in source)
INITIAL_ADMIN_PHONE="REPLACE_WITH_ADMIN_PHONE_11_DIGITS"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
INITIAL_ADMIN_FIRST_NAME="Admin"
INITIAL_ADMIN_LAST_NAME="User"

# File storage (use an ABSOLUTE path on your system)
# Windows example: "C:/Users/MS/Documents/MyProjects/Chat-App/storage"
# Linux/macOS example: "/home/user/Chat-App/storage"
STORAGE_DIR="REPLACE_WITH_ABSOLUTE_PATH_TO_STORAGE_FOLDER"

CHUNK_SIZE_BYTES="1048576"

# WebSocket mini-service
WEBSOCKET_PORT="3003"
WEBSOCKET_BRIDGE_TOKEN="REPLACE_WITH_BRIDGE_TOKEN"

# App
NEXT_PUBLIC_APP_NAME="Chatgram"
NEXT_PUBLIC_WS_PORT="3003"

# GitHub (used only locally for git push, NEVER committed)
# GITHUB_TOKEN is read from environment at deploy time, NOT from .env in repo
