@page "/app"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IChatHubClient Hub
@inject IAppToastService Toast
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="chat-app @(ShowConversation ? "show-conversation" : "")">
            <aside class="sidebar">
                <div class="sidebar-header">
                    <div class="user-info">
                        <UserAvatar Url="@CurrentUser?.AvatarUrl" Name="@CurrentUser?.FullName" Size="40" />
                        <div class="user-name">
                            <span class="name">@CurrentUser?.FullName</span>
                            <span class="phone">@(CurrentUser?.PhoneNumber ?? "")</span>
                        </div>
                    </div>
                    <div class="header-actions">
                        <a href="/app/new" class="icon-btn" title="گفتگوی جدید">
                            <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3H5a2 2 0 0 0-2 2v14l2-1h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM7 12h10v2H7zm0-4h10v2H7z"/></svg>
                        </a>
                        <a href="/settings" class="icon-btn" title="تنظیمات">
                            <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19.1 12.9c0-.3.1-.6.1-.9s0-.6-.1-.9l2-1.6c.2-.2.2-.4.1-.6l-1.9-3.3c-.1-.2-.4-.3-.6-.2l-2.4.9c-.5-.4-1-.7-1.5-.9l-.4-2.5c-.1-.3-.3-.4-.5-.4h-3.8c-.3 0-.5.2-.5.4l-.4 2.5c-.5.2-1 .5-1.5.9L4.4 5.5c-.2-.1-.5 0-.6.2L1.9 9c-.1.2-.1.4.1.6l2 1.6c0 .3-.1.6-.1.9s0 .6.1.9l-2 1.6c-.2.2-.2.4-.1.6l1.9 3.3c.1.2.4.3.6.2l2.4-.9c.5.4 1 .7 1.5.9l.4 2.5c.1.3.3.4.5.4h3.8c.3 0 .5-.2.5-.4l.4-2.5c.5-.2 1-.5 1.5-.9l2.4.9c.2.1.5 0 .6-.2l1.9-3.3c.1-.2.1-.4-.1-.6l-2-1.6zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>
                        </a>
                        @if (IsAdmin)
                        {
                            <a href="/admin" class="icon-btn admin-btn" title="پنل مدیر">
                                <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>
                            </a>
                        }
                        <button class="icon-btn" @onclick="LogoutAsync" title="خروج">
                            <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M17 7l-1.4 1.4L18.2 11H8v2h10.2l-2.6 2.6L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="search-bar">
                    <input type="search" value="@SearchQuery" @oninput="@(e => { SearchQuery = e.Value?.ToString() ?? ""; _ = SearchAsync(); })" placeholder="جستجوی گفتگوها..." />
                </div>
                <ConversationList Conversations="@Conversations" Loading="@LoadingConversations" SelectedId="@SelectedConversationId" OnSelect="@SelectConversationAsync" />
            </aside>
            <main class="chat-main">
                @if (SelectedConversation is not null)
                {
                    <ChatWindow Conversation="@SelectedConversation" CurrentUser="@CurrentUser" OnBack="@(() => ShowConversation = false)" />
                }
                else
                {
                    <div class="empty-chat">
                        <div class="empty-icon">
                            <svg viewBox="0 0 24 24" width="80" height="80"><path fill="currentColor" opacity="0.3" d="M12 2C6.5 2 2 6 2 11c0 1.8.6 3.5 1.6 5L2 22l6-1.6c1.5.7 3 1 4.5 1 5.5 0 10-4 10-9S17.5 2 12 2z"/></svg>
                        </div>
                        <h2>گفتگویی انتخاب نشده</h2>
                        <p>برای شروع یک گفتگوی جدید روی دکمه + بزنید یا از لیست گفتگوها یکی را انتخاب کنید.</p>
                    </div>
                }
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="redirecting">
            <p>در حال انتقال به صفحه ورود...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserDto? CurrentUser;
    private bool IsAdmin;
    private List<ConversationDto> Conversations = new();
    private List<ConversationDto> FilteredConversations = new();
    private string SearchQuery = "";
    private bool LoadingConversations = true;
    private Guid? SelectedConversationId;
    private ConversationDto? SelectedConversation;
    private bool ShowConversation;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadCurrentUserAsync();
        if (CurrentUser is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsAdmin = string.Equals(CurrentUser.Role, "admin", StringComparison.OrdinalIgnoreCase);

        await LoadConversationsAsync();
        await Hub.StartAsync();

        Hub.OnMessage += OnHubMessageAsync;
        Hub.OnUserOnline += OnUserOnlineAsync;
        Hub.OnUserOffline += OnUserOfflineAsync;
        Hub.OnMessageDelivered += OnMessageDeliveredAsync;
        Hub.OnMessageRead += OnMessageReadAsync;

        // Refresh conversations every 15s for last message updates
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            try { await LoadConversationsAsync(); } catch { }
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task LoadCurrentUserAsync()
    {
        try
        {
            CurrentUser = await Http.GetFromJsonAsync<UserDto>("/api/users/me");
        }
        catch { }
    }

    private async Task LoadConversationsAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<ConversationDto>>("/api/conversations") ?? new();
            Conversations = list;
            FilteredConversations = string.IsNullOrWhiteSpace(SearchQuery)
                ? list
                : list.Where(c => (c.OtherParticipant?.FullName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                              || (c.LastMessagePreview?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
            LoadingConversations = false;
            StateHasChanged();
        }
        catch
        {
            LoadingConversations = false;
        }
    }

    private async Task SearchAsync()
    {
        await LoadConversationsAsync();
    }

    private async Task SelectConversationAsync(ConversationDto conv)
    {
        SelectedConversation = conv;
        SelectedConversationId = conv.Id;
        ShowConversation = true;
        await Hub.JoinConversationAsync(conv.Id);
        await Http.PostAsync($"/api/conversations/{conv.Id}/read", null);
        StateHasChanged();
    }

    private async Task OnHubMessageAsync(HubMessage msg)
    {
        await InvokeAsync(async () =>
        {
            // Refresh conversation list (last message preview)
            await LoadConversationsAsync();
            StateHasChanged();
        });
    }

    private async Task OnUserOnlineAsync(Guid userId)
    {
        await InvokeAsync(() =>
        {
            var conv = Conversations.FirstOrDefault(c => c.OtherParticipant?.Id == userId);
            if (conv?.OtherParticipant is not null) conv.OtherParticipant.IsOnline = true;
            StateHasChanged();
        });
    }

    private async Task OnUserOfflineAsync(Guid userId)
    {
        await InvokeAsync(() =>
        {
            var conv = Conversations.FirstOrDefault(c => c.OtherParticipant?.Id == userId);
            if (conv?.OtherParticipant is not null) conv.OtherParticipant.IsOnline = false;
            StateHasChanged();
        });
    }

    private async Task OnMessageDeliveredAsync(DeliveryPayload p)
    {
        await Task.CompletedTask;
        // The chat window component will handle this through its own state
    }

    private async Task OnMessageReadAsync(ReadPayload p)
    {
        await Task.CompletedTask;
    }

    private async Task LogoutAsync()
    {
        var token = await (Tokens as IJwtTokenStore)!.GetRefreshTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            try { await Http.PostAsJsonAsync("/api/auth/logout", token); } catch { }
        }
        await (Tokens as IJwtTokenStore)!.ClearAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    [Inject] private IJwtTokenStore Tokens { get; set; } = null!;

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        _ = Hub.StopAsync();
    }
}
