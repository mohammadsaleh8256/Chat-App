@page "/app"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IChatHubClient Hub
@inject IJwtTokenStore Tokens
@inject IAppToastService Toast
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="chat-app @(ShowConversation ? "show-conversation" : "")">
            <aside class="sidebar">
                <div class="sidebar-header">
                    <div class="user-info">
                        <UserAvatar Url="@CurrentUser?.AvatarUrl" Name="@CurrentUser?.FullName" Size="40" />
                        <div class="user-name">
                            <span class="name">@CurrentUser?.FullName</span>
                            <span class="phone">@FormatPhone(CurrentUser?.PhoneNumber)</span>
                        </div>
                    </div>
                    <div class="header-actions">
                        <a href="/app/new" class="icon-btn" title="گفتگوی جدید">
                            <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3H5a2 2 0 0 0-2 2v14l2-1h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zM7 12h10v2H7zm0-4h10v2H7z"/></svg>
                        </a>
                        @if (IsAdmin)
                        {
                            <a href="/admin" class="icon-btn admin-btn" title="پنل مدیر">
                                <svg width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>
                            </a>
                        }
                        <button class="icon-btn" @onclick="LogoutAsync" title="خروج">
                            <svg width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M17 7l-1.4 1.4L18.2 11H8v2h10.2l-2.6 2.6L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="search-bar">
                    <input type="search" value="@SearchQuery" @oninput="OnSearchInput" placeholder="جستجوی گفتگوها..." />
                </div>
                <ConversationList Conversations="@FilteredConversations" Loading="@LoadingConversations" SelectedId="@SelectedConversationId" OnSelect="@SelectConversationAsync" />
            </aside>
            <main class="chat-main">
                @if (SelectedConversation is not null)
                {
                    <ChatWindow Conversation="@SelectedConversation" CurrentUser="@CurrentUser" OnBack="@(() => ShowConversation = false)" />
                }
                else
                {
                    <div class="empty-chat">
                        <div class="empty-icon">
                            <svg viewBox="0 0 24 24" width="80" height="80"><path fill="currentColor" opacity="0.3" d="M12 2C6.5 2 2 6 2 11c0 1.8.6 3.5 1.6 5L2 22l6-1.6c1.5.7 3 1 4.5 1 5.5 0 10-4 10-9S17.5 2 12 2z"/></svg>
                        </div>
                        <h2>گفتگویی انتخاب نشده</h2>
                        <p>برای شروع یک گفتگوی جدید روی دکمه + بزنید یا از لیست گفتگوها یکی را انتخاب کنید.</p>
                    </div>
                }
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="redirecting">
            <p>در حال انتقال به صفحه ورود...</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private UserDto? CurrentUser;
    private bool IsAdmin;
    private List<ConversationDto> Conversations = new();
    private List<ConversationDto> FilteredConversations = new();
    private string SearchQuery = "";
    private bool LoadingConversations = true;
    private Guid? SelectedConversationId;
    private ConversationDto? SelectedConversation;
    private bool ShowConversation;
    private System.Threading.Timer? _refreshTimer;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadCurrentUserAsync();
        if (CurrentUser is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        IsAdmin = string.Equals(CurrentUser.Role, "admin", StringComparison.OrdinalIgnoreCase);

        await LoadConversationsAsync();

        // Start SignalR — wait for it but don't block UI on errors
        _ = Task.Run(async () =>
        {
            try { await Hub.StartAsync(); }
            catch (Exception ex) { Console.Error.WriteLine($"Hub start failed: {ex.Message}"); }
        });

        Hub.OnMessage += OnHubMessageAsync;
        Hub.OnUserOnline += OnUserOnlineAsync;
        Hub.OnUserOffline += OnUserOfflineAsync;

        _refreshTimer = new System.Threading.Timer(_ => _ = RefreshAsync(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        _initialized = true;
    }

    private async Task LoadCurrentUserAsync()
    {
        try { CurrentUser = await Http.GetFromJsonAsync<UserDto>("/api/users/me"); }
        catch { }
    }

    private async Task LoadConversationsAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<ConversationDto>>("/api/conversations") ?? new();
            Conversations = list;
            ApplyFilter();
            LoadingConversations = false;
        }
        catch
        {
            LoadingConversations = false;
        }
    }

    private void ApplyFilter()
    {
        FilteredConversations = string.IsNullOrWhiteSpace(SearchQuery)
            ? Conversations
            : Conversations.Where(c =>
                (c.OtherParticipant?.FullName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.LastMessagePreview?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchQuery = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private async Task SearchAsync()
    {
        await LoadConversationsAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadConversationsAsync();
                StateHasChanged();
            });
        }
        catch { }
    }

    private async Task SelectConversationAsync(ConversationDto conv)
    {
        SelectedConversation = conv;
        SelectedConversationId = conv.Id;
        ShowConversation = true;
        _ = Hub.JoinConversationAsync(conv.Id);
        try { await Http.PostAsync($"/api/conversations/{conv.Id}/read", null); }
        catch { }
    }

    private async Task OnHubMessageAsync(HubMessage msg)
    {
        await InvokeAsync(async () =>
        {
            await LoadConversationsAsync();
            StateHasChanged();
        });
    }

    private Task OnUserOnlineAsync(Guid userId) =>
        InvokeAsync(() =>
        {
            var conv = Conversations.FirstOrDefault(c => c.OtherParticipant?.Id == userId);
            if (conv?.OtherParticipant is not null) conv.OtherParticipant.IsOnline = true;
            StateHasChanged();
            return Task.CompletedTask;
        });

    private Task OnUserOfflineAsync(Guid userId) =>
        InvokeAsync(() =>
        {
            var conv = Conversations.FirstOrDefault(c => c.OtherParticipant?.Id == userId);
            if (conv?.OtherParticipant is not null) conv.OtherParticipant.IsOnline = false;
            StateHasChanged();
            return Task.CompletedTask;
        });

    private async Task LogoutAsync()
    {
        try
        {
            var token = await Tokens.GetRefreshTokenAsync();
            if (!string.IsNullOrEmpty(token))
            {
                await Http.PostAsJsonAsync("/api/auth/logout", token);
            }
            await Tokens.ClearAsync();
        }
        catch { }
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private static string FormatPhone(string? phone)
    {
        if (string.IsNullOrEmpty(phone)) return "";
        if (phone.StartsWith("+98")) return "0" + phone[3..];
        if (phone.StartsWith("98")) return "0" + phone[2..];
        return phone;
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
        Hub.OnMessage -= OnHubMessageAsync;
        Hub.OnUserOnline -= OnUserOnlineAsync;
        Hub.OnUserOffline -= OnUserOfflineAsync;
        _ = Hub.StopAsync();
    }
}
