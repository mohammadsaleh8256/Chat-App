@page "/admin"
@page "/admin/users"
@page "/admin/audit"
@page "/admin/settings"
@rendermode InteractiveServerNoPrerender
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IAppToastService Toast

<AuthorizeView>
    <Authorized>
        @if (!CheckingAdmin && IsAdmin)
        {
            <div class="admin-shell">
                <aside class="admin-sidebar">
                    <div class="admin-logo">
                        <h2>پنل مدیر</h2>
                    </div>
                    <nav class="admin-nav">
                        <a href="/admin" class="nav-item @(ActiveTab == "dashboard" ? "active" : "")">
                            <span class="nav-icon">📊</span>
                            داشبورد
                        </a>
                        <a href="/admin/users" class="nav-item @(ActiveTab == "users" ? "active" : "")">
                            <span class="nav-icon">👥</span>
                            کاربران
                        </a>
                        <a href="/admin/audit" class="nav-item @(ActiveTab == "audit" ? "active" : "")">
                            <span class="nav-icon">📝</span>
                            لاگ‌های ممیزی
                        </a>
                        <a href="/admin/settings" class="nav-item @(ActiveTab == "settings" ? "active" : "")">
                            <span class="nav-icon">⚙️</span>
                            تنظیمات
                        </a>
                        <a href="/app" class="nav-item">
                            <span class="nav-icon">←</span>
                            بازگشت به چت
                        </a>
                    </nav>
                </aside>
                <main class="admin-content">
                    @switch (ActiveTab)
                    {
                        case "dashboard": <AdminDashboard />; break;
                        case "users": <AdminUsers />; break;
                        case "audit": <AdminAudit />; break;
                        case "settings": <AdminSettings />; break;
                    }
                </main>
            </div>
        }
        else if (CheckingAdmin)
        {
            <div class="admin-check"><span class="spinner"></span></div>
        }
    </Authorized>
    <NotAuthorized>
        <p class="redirecting">در حال انتقال به صفحه ورود...</p>
        <script>setTimeout(() => location.href = '/login', 800);</script>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string ActiveTab = "dashboard";
    private bool CheckingAdmin = true;
    private bool IsAdmin;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        try
        {
            var u = await Http.GetFromJsonAsync<UserDto>("/api/users/me");
            IsAdmin = string.Equals(u?.Role, "admin", StringComparison.OrdinalIgnoreCase);
        }
        catch { }

        CheckingAdmin = false;
        if (!IsAdmin) Nav.NavigateTo("/app", forceLoad: true);

        var path = Nav.Uri;
        if (path.Contains("/users")) ActiveTab = "users";
        else if (path.Contains("/audit")) ActiveTab = "audit";
        else if (path.Contains("/settings")) ActiveTab = "settings";
    }
}
