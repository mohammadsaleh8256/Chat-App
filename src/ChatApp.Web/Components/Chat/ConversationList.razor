@if (Loading)
{
    <div class="conv-list-loading">
        @for (var i = 0; i < 5; i++)
        {
            <div class="conv-skeleton">
                <div class="avatar-skeleton"></div>
                <div class="text-skeleton">
                    <div class="line"></div>
                    <div class="line short"></div>
                </div>
            </div>
        }
    </div>
}
else if (!Conversations.Any())
{
    <div class="conv-list-empty">
        <p>گفتگویی وجود ندارد.</p>
        <p class="hint">برای شروع یک گفتگوی جدید روی دکمه + در بالا بزنید.</p>
    </div>
}
else
{
    <div class="conversation-list">
        @foreach (var c in Conversations)
        {
            <div class="conversation-item @(c.Id == SelectedId ? "selected" : "")" @onclick="@(() => OnSelect.InvokeAsync(c))">
                <UserAvatar Url="@c.OtherParticipant?.AvatarUrl" Name="@c.OtherParticipant?.FullName" Size="48" ShowOnline="true" IsOnline="@(c.OtherParticipant?.IsOnline ?? false)" />
                <div class="conv-content">
                    <div class="conv-top-row">
                        <span class="conv-name">@(c.OtherParticipant?.FullName ?? c.Title ?? "بدون نام")</span>
                        @if (c.LastMessageAt.HasValue)
                        {
                            <span class="conv-time">@c.LastMessageAt.Value.ToRelativeTime()</span>
                        }
                    </div>
                    <div class="conv-bottom-row">
                        <span class="conv-preview">@(c.LastMessagePreview ?? "گفتگو را شروع کنید")</span>
                        @if (c.UnreadCount > 0)
                        {
                            <span class="unread-badge">@c.UnreadCount</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<ConversationDto> Conversations { get; set; } = new List<ConversationDto>();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<ConversationDto> OnSelect { get; set; }
}
